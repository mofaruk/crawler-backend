# --- Host Port Mapping ---
# Override these to avoid conflicts with other services on the host.
CRAWLER_API_PORT=8088
CRAWLER_METRICS_PORT=9098
CRAWLER_REDIS_PORT=6382
CRAWLER_MONGO_PORT=27020
CRAWLER_PROMETHEUS_PORT=9095
CRAWLER_GRAFANA_PORT=3030

# --- API Configuration ---
SERVICE_NAME=crawler-backend
API_PORT=8080
METRICS_PORT=9090
LOG_LEVEL=info

# --- MongoDB ---
MONGO_URI=mongodb://crawler_mongodb:27017
MONGO_DB=crawler
MONGO_POOL_SIZE=100

# --- Redis ---
REDIS_ADDR=crawler_redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Worker Configuration ---
WORKER_CONCURRENCY=200
WORKER_POLL_INTERVAL=100ms
WORKER_BATCH_SIZE=50

# --- Crawler ---
CRAWLER_TIMEOUT=30s
CRAWLER_MAX_RETRIES=3
DEFAULT_USER_AGENT=WK-Crawler/1.0

# --- Webhook ---
WEBHOOK_TIMEOUT=10s
WEBHOOK_MAX_RETRIES=3

# --- Security ---
# Shared secret required on every endpoint except /health, sent as
# "X-API-Key: <key>" or "Authorization: Bearer <key>". MUST be set in
# production — the service starts with a loud warning when it is empty, and
# the API is completely unauthenticated in that state.
# Generate with: openssl rand -hex 24
CRAWLER_API_KEY=

# Comma-separated CORS allowlist. Empty (the default) means no cross-origin
# browser access at all, which is correct: the dashboard calls this API
# server-to-server from PHP, never from the browser.
ALLOWED_ORIGINS=

# Disables the SSRF guard so sources on host.docker.internal / 127.0.0.1 can
# be crawled. LOCAL DEVELOPMENT ONLY — must be false in production, or any
# caller can make the crawler read cloud metadata and internal services.
CRAWLER_ALLOW_PRIVATE_TARGETS=true
